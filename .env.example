# Copy to .env and fill in. Never commit real secrets.

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growthop

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic Claude (AI mentor)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (embeddings + reranker)
VOYAGE_API_KEY=pa-...

# Object storage / CDN (Cloudflare R2 or S3)
STORAGE_BUCKET=growthop-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
CDN_BASE_URL=https://cdn.example.com
